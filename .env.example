# Copy to .env.local, supply real public project settings, then restart Vite.
# VITE_* values are compiled into the browser. Never place privileged secrets here.
# Build rejects recognized secrets/service-role or user-session JWTs before bundling.
# This is defense in depth, not permission to put an unknown secret in VITE_*.

# REQUIRED: Project Settings → API / API Keys → HTTPS project URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# REQUIRED: browser-safe sb_publishable_... key or legacy anon JWT, NEVER service-role.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional LOCAL-ONLY sample preview. Also hard-disabled in production builds.
VITE_ENABLE_DEMO_PREVIEW=false

# REQUIRED FOR PRODUCTION MAPS: licensed Web Mercator HTTPS raster tiles and credits.
# Use one hostname and the {z}/{x}/{y} template; no {s} subdomain placeholder.
# No production fallback. Local development alone may use limited OSM demo tiles.
# VITE_MAP_TILE_URL=https://tiles.example.invalid/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Your approved provider attribution

# Edge service keys, database passwords, CLI tokens and maintenance secrets are server-only.
# See docs/DEPLOYMENT.md; NEVER add VITE_ versions of them or commit local env files.
