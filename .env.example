# DropZone Phase 1 — Vite/Supabase Auth and trusted event access
# Copy to .env.local, set the two required values, then restart the dev server.

# REQUIRED · browser-visible project endpoint from Supabase → Project Settings → API / API Keys.
# Use your project's HTTPS URL for hosted environments. Local Supabase prints its local URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# REQUIRED · browser-safe publishable key (sb_publishable_...) or legacy anon JWT from
# Supabase → Project Settings → API / API Keys. It is intentionally public; database access must be
# protected by the migration's RLS policies. NEVER put a service-role/secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# OPTIONAL · development-only access to the isolated, sample-data prototype at
# /development-preview. It is ignored in production builds and defaults to disabled.
VITE_ENABLE_DEMO_PREVIEW=false

# No service-role key, database password, direct database URL, map provider key, or cron secret
# is used by the Phase 1 browser application. Never prefix privileged values with VITE_.
# Phase 2 server-side integrations must define and document their own trusted runtime variables.

# Optional public raster tile configuration; default is OpenStreetMap standard tiles.
# Review provider terms/traffic limits before using at event scale.
# VITE_MAP_TILE_URL=https://your-authorized-provider/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Your map provider attribution
# Edge Function service keys and maintenance secrets are SERVER-ONLY; never add VITE_ versions.
